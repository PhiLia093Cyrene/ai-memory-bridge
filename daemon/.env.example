# bridge_pusher.py 配置文件示例
# 复制为 .env 并填好真实值

# cyrene-bridge 服务地址
# 例:http://localhost:18800 或 http://your-vps-ip:18800
BRIDGE_URL=http://localhost:18800

# 与 cyrene-bridge 的 BRIDGE_AUTH_TOKEN 一致
BRIDGE_TOKEN=your-bridge-auth-token-here

# AstrBot 容器内 conversations.db 路径
# 默认: /AstrBot/data/plugin_data/astrbot_plugin_livingmemory/conversations.db
ASTRBOT_CONVERSATIONS_DB=/AstrBot/data/plugin_data/astrbot_plugin_livingmemory/conversations.db

# messages 表名(默认 messages,一般不用改)
ASTRBOT_MESSAGES_TABLE=messages

# 推送开关(true / false)
BRIDGE_PUSHER_ENABLED=true

# 轮询间隔(秒,默认 3)
BRIDGE_POLL_INTERVAL=3

# 每日推送上限(默认 500)
BRIDGE_MAX_PER_DAY=500
