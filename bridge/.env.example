# cyrene-bridge 配置示例
# 复制为 .env 并填好真实值

# === 网关服务 ===
BRIDGE_PORT=18800

# === 鉴权 Token(必填,32+ 字符随机串)===
# 生成: openssl rand -hex 32
BRIDGE_AUTH_TOKEN=replace-me-with-a-long-random-string

# === Embedding 配置(OpenAI 兼容接口)===
# 默认配置:阿里云 DashScope (千问)
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-embedding-api-key
# 可选模型:
#   text-embedding-v3 (1024 维, 推荐)
#   text-embedding-v2 (1536 维, 旧)
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# === 写入开关(安全) ===
# 默认 false:接收推送但不算 embedding 不落盘
# 确认数据格式正确后再改 true
BRIDGE_WRITE_ENABLED=false

# === 存储路径(容器内)===
DATA_DIR=/app/data
JSONL_FILE=/app/data/cyrene_bridge.jsonl

# === 可选: 同步到下游 LivingMemory(留空 = 禁用 /v1/sync)===
# 容器内路径(因为 docker-compose.yml 把 livingmemory.db 挂载到这里)
LIVINGMEMORY_DB_PATH=/app/livingmemory-data/livingmemory.db
# 写入的 persona 名(对应你的 AI agent persona)
LIVINGMEMORY_SYNC_PERSONA=default
# 标识数据来源(查询时方便过滤)
LIVINGMEMORY_SYNC_SESSION=cyrene-bridge

# === 后台自动同步(默认 60 秒一次)===
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SEC=60
